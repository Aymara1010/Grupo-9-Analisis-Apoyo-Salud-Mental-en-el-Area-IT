table 'Selector Pregunta'
	lineageTag: 3c090046-1273-4115-88b0-d910c6343a95

	measure 'Titulo Dinamico' =
			
			IF(
			    ISFILTERED('Selector Pregunta'),
			    SWITCH(
			        SELECTEDVALUE('Selector Pregunta'[Selector Pregunta Orden]),
			        0, "¿Sabes qué apoyo mental te ofrece tu empresa?",
			        1, "¿Tu empresa ofrece beneficios de salud mental?",
			        2, "¿Tu empresa protege tu privacidad si buscas tratamiento?"
			    ),
			    ""
			)
		lineageTag: ca7530e6-28aa-40fc-89cc-f95c28c7df60

	column 'Selector Pregunta'
		lineageTag: cc9d3b29-24ff-45f3-941d-6ec002bb3e6f
