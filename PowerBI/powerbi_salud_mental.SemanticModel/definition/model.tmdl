model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["main Dim_Beneficio_Trabajo","main Dim_Categorias_Sugerencia","main Dim_Emociones","main Dim_Encuesta","main Dim_Estado_Mental","main Dim_Estado_USA","main Dim_Info_Encuestado","main Dim_Pais","main Dim_Trabajo_Encuestado","main Fact_Respuesta_Encuestado"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'main Dim_Beneficio_Trabajo'
ref table 'main Dim_Categorias_Sugerencia'
ref table 'main Dim_Emociones'
ref table 'main Dim_Encuesta'
ref table 'main Dim_Estado_Mental'
ref table 'main Dim_Estado_USA'
ref table 'main Dim_Info_Encuestado'
ref table 'main Dim_Pais'
ref table 'main Dim_Trabajo_Encuestado'
ref table 'main Fact_Respuesta_Encuestado'

ref cultureInfo es-ES

